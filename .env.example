# PetWell Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
# Production (Zeabur / Docker)
DATABASE_URL=postgresql://user:password@hostname:port/dbname
# Fallback local configurations (optional)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=petwell

# HK insurance RAG (Go-owned primary path)
HK_INSURANCE_RAG_ENABLED=true
HK_INSURANCE_RAG_DATA_PATH=assets/rag/hk_insurance
HK_INSURANCE_RAG_TOP_K=6
HK_INSURANCE_RAG_REBUILD_ON_START=false
HK_INSURANCE_RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
HK_INSURANCE_RAG_EMBEDDING_MODEL=BAAI/bge-m3
HK_INSURANCE_RAG_EMBEDDING_API_KEY=
HK_INSURANCE_RAG_LLM_BASE_URL=https://api.siliconflow.cn/v1
HK_INSURANCE_RAG_LLM_MODEL=stepfun-ai/Step-3.5-Flash
HK_INSURANCE_RAG_LLM_API_KEY=

# Google Maps API (for clinic/vet location services)
MAPS_API_KEY=your_google_maps_api_key_here

# Merchant facade bridge (Scheme 4 R1 -> R2)
MERCHANT_FACADE_BASE_URL=http://127.0.0.1:8090
MERCHANT_FACADE_APP_KEY=
# Merchant-origin booking sync intake (R2 -> R1)
BOOKING_SYNC_SHARED_SECRET=
# App-facing mirror freshness window (seconds)
BOOKING_MIRROR_FRESHNESS_SECONDS=120
# Optional background stale reconcile loop (R1 self-calls /api/bookings/reconcile-stale)
BOOKING_RECONCILE_INTERVAL_SECONDS=
BOOKING_RECONCILE_LIMIT=50
BOOKING_RECONCILE_SYNC_STATE=
BOOKING_RECONCILE_FORCE=false

# Shopify Storefront API Configuration
# Get these from Shopify Admin > Headless > Storefront API
SHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=your_private_storefront_access_token_here
# Deprecated compatibility fallback. Leave empty after private-token cutover.
SHOPIFY_STOREFRONT_TOKEN=
# Shopify Dev Dashboard app credentials. The backend exchanges these for a
# 24-hour Admin token and refreshes it before expiry. Required scopes:
# read_orders, write_orders, read_fulfillments, read_returns, write_returns.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional legacy/cutover fallback. New Dev Dashboard apps should normally rely
# on the client credentials above.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-07
# Shopify app client secret used to verify Admin webhooks.
SHOPIFY_WEBHOOK_SECRET=

# Stripe PaymentSheet Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Signing secret for POST /api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Mock Mode (for development without real Shopify credentials)
# Set to "true" to use mock data instead of calling real Shopify API
USE_MOCK_SHOPIFY=false

# Multi-agent health report extraction (placeholders)
# Set up to 3 vendors. Leave endpoint empty to disable a vendor.
# Bailian / Anthropic-compatible example:
# REPORT_AGENT_1_ENDPOINT=https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic/v1/messages
# REPORT_AGENT_1_API_KEY=<ANTHROPIC_AUTH_TOKEN>
# REPORT_AGENT_1_MODEL=qwen3.6-plus
REPORT_AGENT_1_ID=vendor_a
REPORT_AGENT_1_ENDPOINT=
REPORT_AGENT_1_API_KEY=
REPORT_AGENT_1_MODEL=MODEL_A
REPORT_AGENT_1_RELIABILITY=0.80

REPORT_AGENT_2_ID=vendor_b
REPORT_AGENT_2_ENDPOINT=
REPORT_AGENT_2_API_KEY=
REPORT_AGENT_2_MODEL=MODEL_B
REPORT_AGENT_2_RELIABILITY=0.85

REPORT_AGENT_3_ID=vendor_c
REPORT_AGENT_3_ENDPOINT=
REPORT_AGENT_3_API_KEY=
REPORT_AGENT_3_MODEL=MODEL_C
REPORT_AGENT_3_RELIABILITY=0.90

# Tencent COS (Hong Kong recommended)
# Example bucket URL: https://<bucket-appid>.cos.ap-hongkong.myqcloud.com
COS_SECRET_ID=YOUR_COS_SECRET_ID
COS_SECRET_KEY=YOUR_COS_SECRET_KEY
COS_BUCKET_NAME=YOUR_BUCKET_NAME
COS_BUCKET_URL=YOUR_BUCKET_URL
COS_SIGNED_URL_EXPIRE_SECONDS=900
